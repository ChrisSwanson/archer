C4Container
    title Archer containers: one archer.js bundle, several processes
    Person(person, "Person")
    Person_Ext(agent, "Coding agent")
    System_Boundary(archer, "Archer") {
        Container(plugin, "Claude plugin", "ts/plugin", "Skill, MCP server entry, /draw /diagrams /present commands")
        Container(mcp, "MCP server", "archer mcp, stdio", "One per agent session; tools from the shared application layer")
        Container(cli, "CLI", "node archer.js", "init, list, validate, compile, draw, migrate, tools, docs, call, serve, stop")
        Container(app, "Application layer", "ts/src/application", "Every operation: schemas, validation, refusals, text or JSON results")
        Container(service, "Background service", "archer serve, Node", "One per service name: management socket, HTTP data plane, watchers, project state")
        Container(page, "Archer page", "React, ui/ built to archer-ui.html", "Canvas, notes reader, comments, export, accuracy")
    }
    ContainerDb_Ext(folder, "Archer folder", ".archer/", "diagrams .mmd, notes .md, .comments.json files")
    ContainerDb_Ext(toml, "archer.toml", "TOML subset", "version, folder, name, registered views with covers")
    ContainerDb_Ext(account, "Account state", "~/.local/state/archer", "service.json, archer.sock, runtime/ recovery")
    Rel(agent, plugin, "Loads")
    Rel(plugin, mcp, "Starts", "node dist/archer.js mcp")
    Rel(plugin, cli, "Runs for slash commands")
    Rel(agent, mcp, "Calls tools", "MCP over stdio")
    Rel(agent, cli, "Runs commands", "shell")
    Rel(mcp, app, "createApplication, call")
    Rel(cli, app, "Runs commands", "", "archer call, emphasis, serve, stop")
    Rel(app, folder, "Reads, writes atomically")
    Rel(app, toml, "Registers views", "", "register_diagram rewrites one view block")
    Rel(app, service, "Sends requests", "NDJSON over Unix socket", "attach, present, setEmphasis, recordWrite")
    Rel(service, folder, "Watches, recompiles", "", "Watches, recompiles, serves comments")
    Rel(service, account, "Persists state", "", "Persists after each transaction")
    Rel(service, page, "Serves page, routes and SSE", "HTTP")
    Rel(page, service, "Posts changes", "HTTP", "POST selection, comments, operations")
    Rel(person, page, "Reads and comments")
