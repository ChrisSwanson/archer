{
  // The docs site: VitePress config and theme, the build scripts and the browser tests
  // (`npm run typecheck:site`). As strict as ts/tsconfig.json (stricter than ui's): the build scripts
  // import ts/src, which needs its exactOptionalPropertyTypes, and ts's typecheck already held them to
  // it. `vue-tsc` reads it, so the theme's .vue files are checked with the rest.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "types": ["node", "vite/client"]
  },
  // The painter's module declaration, which ts/ and ui/ resolve through their own configs.
  "files": ["../ts/src/export/painter.d.ts"],
  "include": [
    ".vitepress/**/*.ts",
    ".vitepress/**/*.mts",
    ".vitepress/**/*.vue",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "tests/**/*.ts",
    "*.ts"
  ],
  "exclude": [".vitepress/cache", ".vitepress/dist"]
}
