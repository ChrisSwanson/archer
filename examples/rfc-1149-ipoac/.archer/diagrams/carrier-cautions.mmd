%% description: Compare independent carrier and route cautions without turning bulk transfer advice or hazards into a deterministic routing algorithm.
flowchart TB
    %% archer-key service: Service option
    %% archer-key hazard: Delivery hazard
    %% archer-key restriction: Routing restriction
    choice{Carrier Choice?}
    carrier[Avian Carrier]:::system
    ostrich[Ostrich]:::service
    bridges[Bridges Between Domains]:::restriction
    bulk[Greater Bulk, Slower Delivery]:::service
    flight[Datagram in Transit]:::service
    hawk[Unintentional Hawk Encapsulation]:::hazard
    mangled[Mangled Packets]:::hazard
    strict[Strict Source Routes]:::restriction
    choke[Choke-Point]:::hazard
    choice choose_avian@-->|Standard carrier| carrier
    choice choose_ostrich@-->|Alternate carrier| ostrich
    ostrich needs_bridges@-->|Requires| bridges
    ostrich bulk_delivery@-->|Carries| bulk
    carrier carries_datagram@-->|Carries| flight
    flight hawk_hazard@-->|May encounter| hawk
    hawk messy_decapsulation@-->|Messy decapsulation| mangled
    strict routing_choke@-->|MUST NOT use| choke
    classDef service fill:#176b56,stroke:#176b56
    classDef hazard fill:#a52a36,stroke:#a52a36
    classDef restriction fill:#884f24,stroke:#884f24

