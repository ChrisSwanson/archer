%% description: Trace wing marking into a class queue and through the departure gate; the proper time has no specified scheduling formula.
flowchart TB
    %% archer-key classification: Service classification
    %% archer-key queueing: Queue operation
    %% archer-key optional: Optional mechanism
    %% archer-key dotted: Optional mechanism
    barcode[Wing Bar Code]:::classification
    scan[Bar-Code Reader]:::classification
    level{Service Level?}:::classification
    concorde[Concorde Queue]:::queueing
    first[First Queue]:::queueing
    business[Business Queue]:::queueing
    coach[Coach Queue]:::queueing
    gate[Gated Queue]:::queueing
    departure[Departure]:::queueing
    red[RED Paint]:::optional
    scales[Scales for WFQ]:::optional
    barcode read_marking@-->|Scan on entry| scan
    scan classify@-->|Read class| level
    level assign_concorde@-->|Concorde| concorde
    level assign_first@-->|First| first
    level assign_business@-->|Business| business
    level assign_coach@-->|Coach| coach
    concorde release_concorde@-->|Enqueue| gate
    first release_first@-->|Enqueue| gate
    business release_business@-->|Enqueue| gate
    coach release_coach@-->|Enqueue| gate
    gate depart@-->|Proper time| departure
    gate deletion_option@-.->|Mark while enqueued| red
    gate wfq_option@-.->|Weigh carriers| scales
    classDef classification fill:#65428c,stroke:#65428c
    classDef queueing fill:#176b56,stroke:#176b56
    classDef optional fill:#884f24,stroke:#884f24

