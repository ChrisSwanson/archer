%% description: Separate body commands, vessel type and a permitted 406 response; other unavailable-additions behaviour is unspecified.
flowchart TB
    %% archer-key command: Coffee command
    %% archer-key caution: Specification caveat
    %% archer-key refusal: Coffee refused
    %% archer-key dotted: Unresolved specification detail
    %% archer-key dashed: Permitted response
    request[BREW or POST]:::command
    media[Content-Type Conflict]:::caution
    body[Start or Stop]:::command
    vessel_check{Vessel?}
    error418[418 I'm a Teapot]:::refusal
    additions{Additions Available?}
    unavailable[Cannot Supply Additions]
    error406[406 Not Acceptable]:::refusal
    unspecified[Other Behaviour Unspecified]:::caution
    start[Start Brewing]:::command
    stop[Stop Brewing]:::command
    request media_conflict@-.->|Two media types| media
    request read_body@-->|Section 4 body| body
    body stop_command@-->|stop| stop
    body start_command@-->|start| vessel_check
    vessel_check teapot_refusal@-->|Teapot| error418
    vessel_check pot_additions@-->|Coffee pot| additions
    additions unavailable_additions@-->|No| unavailable
    unavailable additions_refusal@-->|MAY return| error406
    unavailable other_behaviour@-.->|Otherwise unspecified| unspecified
    additions brew_start@-->|Yes| start
    classDef dashed stroke-dasharray: 6 4
    class additions_refusal dashed
    classDef command fill:#176b56,stroke:#176b56
    classDef caution fill:#884f24,stroke:#884f24
    classDef refusal fill:#a52a36,stroke:#a52a36

