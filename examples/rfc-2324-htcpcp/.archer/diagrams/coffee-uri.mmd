%% description: Read the coffee URI as nested naming parts, including optional host, pot and additions; no request execution order is implied.
erDiagram
    direction LR
    COFFEE_URI["Coffee URI"]
    SCHEME["Coffee Scheme"]
    HOST["Host"]
    POT_DESIGNATOR["Pot Designator"] {
        string form "pot- followed by integer"
    }
    ADDITIONS_LIST["Additions List"]
    COFFEE_URI ||--|| SCHEME : requires
    COFFEE_URI ||--o| HOST : "optionally names"
    COFFEE_URI ||--o| POT_DESIGNATOR : "optionally selects"
    COFFEE_URI ||--o| ADDITIONS_LIST : "optionally requests"

