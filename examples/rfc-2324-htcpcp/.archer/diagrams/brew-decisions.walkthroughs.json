            },
            {
              "kind": "node",
              "id": "additions",
              "label": "Additions Available?"
            }
          ],
          "edges": [
            {
              "id": "teapot_refusal",
              "source": "vessel_check",
              "target": "error418",
              "label": "Teapot"
            },
            {
              "id": "pot_additions",
              "source": "vessel_check",
              "target": "additions",
              "label": "Coffee pot"
            }
          ]
        },
        {
          "id": "may-refuse",
          "title": "Read MAY as a choice",
          "kind": "does",
          "what": "If the operator cannot comply, a 406 MAY be returned (§2.3.1). For a 406 response to a non-HEAD request, the response SHOULD list available additions.",
          "why": "The dashed branch permits 406. Other behaviour is unspecified; no successful fallback or response encoding is inferred.",
          "nodes": [
