      "note": "notes/reading-guide.md",
      "steps": [
        {
          "id": "read-the-command",
          "title": "Read the command, keep the conflict",
          "kind": "does",
          "what": "BREW and POST are equivalent (§2.1.1). Section 4 supplies start or stop, but gives a different Content-Type.",
          "why": "The dotted line records an unresolved contradiction, not a fallback or a new response code.",
          "nodes": [
            {
              "kind": "node",
              "id": "request",
              "label": "BREW or POST"
            },
            {
              "kind": "node",
              "id": "body",
              "label": "Start or Stop"
            },
            {
              "kind": "node",
              "id": "media",
              "label": "Content-Type Conflict"
            }
          ],
          "edges": [
            {
              "id": "media_conflict",
              "source": "request",
              "target": "media",
              "label": "Two media types"
            },
            {
              "id": "read_body",
              "source": "request",
              "target": "body",
              "label": "Section 4 body"
            }
          ]
        },
        {
          "id": "separate-the-vessel",
          "title": "Separate a teapot from a coffee pot",
          "kind": "does",
          "what": "The start branch reaches the vessel question. A teapot should return 418 (§2.3.2); that is separate from unavailable additions.",
          "why": "The diagram is arranged for reading. The RFC does not prescribe a validation order.",
          "nodes": [
            {
              "kind": "node",
              "id": "vessel_check",
              "label": "Vessel?"
            },
            {
