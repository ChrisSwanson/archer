%% Free text in the sequence profile: aliases, message text, notes and
%% fragment labels all run to the end of the line.

sequenceDiagram
    participant web as Web (EU)
    participant quoted as "Web (EU)"
    participant main as Web (EU) - main, v2 %% a trailing comment
    participant taker as Note taker
    web->>quoted: GET /resource?id=1 (cached), please
    quoted-->>web: 100% complete
    web-)main: "100 %% pure"
    main->>web: POST /refresh %% rotates the refresh token
    note RIGHT OF taker: keywords match in any case
    Note over web,quoted: TLS 1.3, mutual auth %% a trailing comment
    loop token refresh (every 15 min) %% a trailing comment
        web->>main: POST /refresh (refresh_token)
    end
    main-)taker:   trimmed
