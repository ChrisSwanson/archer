      },
      {
        "type": "message",
        "id": "msg-2",
        "from": "db",
        "to": "server",
        "label": "user record",
        "kind": "reply"
      },
      {
        "type": "fragment",
        "id": "frag-0",
        "kind": "alt",
        "label": "Credentials valid?",
        "sections": [
          {
            "label": "Valid",
            "events": [
              {
                "type": "message",
                "id": "msg-3",
